<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>Guitar Tuner</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Models\basic-pitch.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Models\basic-pitch-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tools\basic_pitch_worker.py" CopyToOutputDirectory="PreserveNewest" Link="tools\basic_pitch_worker.py" />
    <None Include="tools\requirements-transcription.txt" CopyToOutputDirectory="PreserveNewest" Link="tools\requirements-transcription.txt" />
    <None Include="tools\setup-transcription.ps1" CopyToOutputDirectory="PreserveNewest" Link="tools\setup-transcription.ps1" />
  </ItemGroup>

</Project>
